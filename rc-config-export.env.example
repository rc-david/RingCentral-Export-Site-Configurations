# rc-config-export credentials. Copy to .env next to the script, fill in, then:
#   python .\rc-config-export.py --env-file .env --all-sites --out .\exports
# Or select sites: --site-id 123456 --site-name "Main Site"
# Keep this file private: it grants read access to your whole RingCentral account.

# Production: https://platform.ringcentral.com   Sandbox: https://platform.devtest.ringcentral.com
RC_SERVER_URL=https://platform.ringcentral.com

# From your app at https://developers.ringcentral.com (Apps → your app → Credentials)
RC_CLIENT_ID=
RC_CLIENT_SECRET=

# JWT credential minted for an ADMIN user of the account (Credentials → "Create JWT")
RC_JWT=
